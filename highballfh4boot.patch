kernelbase: Fake GetPackagesByPackageFamily for Forza Horizon 4.

Forza Horizon 4's Arxan DRM requires GetPackagesByPackageFamily to return
a valid UWP package string (Microsoft.VCLibs). If Wine returns a failure
(e.g., APPMODEL_ERROR_NO_PACKAGE), the DRM enters a fallback loop and
deadlocks the main thread at 100% CPU.

This implements a hardcoded success response for Microsoft.VCLibs to
satisfy the DRM and allow the game to boot on CrossOver/macOS.

--- a/dlls/kernelbase/kernelbase.spec
+++ b/dlls/kernelbase/kernelbase.spec
@@ -582,7 +582,7 @@
 @ stdcall GetPackagePath(ptr long ptr ptr)
 @ stdcall GetPackagePathByFullName(wstr ptr ptr)
 @ stdcall GetPackagesByPackageFamily(wstr ptr ptr ptr ptr)
-# @ stub GetPackagesByPackageFamily
+@ stdcall GetPackagesByPackageFamily(wstr ptr ptr ptr ptr)
 @ stdcall GetPerformanceInfo(ptr long) psapi.GetPerformanceInfo
 @ stdcall GetPhysicallyInstalledSystemMemory(ptr)
 @ stdcall GetProcessDefaultCpuSets(long ptr long ptr)
--- a/dlls/kernelbase/main.c
+++ b/dlls/kernelbase/main.c
@@ -750,3 +750,30 @@ HRESULT WINAPI GetAcceptLanguagesW(WCHAR *langbuf, DWORD *buflen)
     *buflen = 0;
     return E_NOT_SUFFICIENT_BUFFER;
 }
+
+/***********************************************************************
+ *          GetPackagesByPackageFamily   (KERNELBASE.@)
+ *
+ * FORZA HORIZON 4 HACK: Arxan Anti-Tamper requires a valid UWP package 
+ * string to be returned, otherwise it deadlocks the game at 100% CPU.
+ ***********************************************************************/
+LONG WINAPI GetPackagesByPackageFamily(PCWSTR family, UINT32 *count, PWSTR *names, UINT32 *buffer_length, WCHAR *buffer)
+{
+    static const WCHAR vclibs[] = L"Microsoft.VCLibs.140.00_14.0.30704.0_x64__8wekyb3d8bbwe";
+    UINT32 len = ARRAY_SIZE(vclibs);
+
+    if (count) *count = 1;
+
+    if (!buffer_length) return ERROR_SUCCESS;
+
+    if (*buffer_length < len || !names || !buffer)
+    {
+        *buffer_length = len;
+        return ERROR_INSUFFICIENT_BUFFER;
+    }
+
+    names[0] = buffer;
+    lstrcpyW(buffer, vclibs);
+    *buffer_length = len;
+
+    return ERROR_SUCCESS;
+}
